# Copy this file to .env and edit values. .env is not committed.
# Only needed if you use docker-compose with the optional env vars below.

# Comma-separated list of origins allowed to call the API.
# In a single-container deploy where the app serves its own frontend, the
# default below is fine.
SHADI_CORS_ORIGINS=http://localhost:8000

# OPTIONAL — Scenario C only.
# If you plan to run the Claude CLI inside the container as the AI backend,
# set this so the CLI uses your Anthropic API key instead of an interactive
# subscription login. Without this, only the API/free-provider paths work.
# ANTHROPIC_API_KEY=sk-ant-...
